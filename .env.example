# Trend Radar - environment variables
# Copy to `.env` and fill in your own values. Never commit `.env`.

# ---- Pipeline (Python) ----

# Google AI Studio API key. Used for: Gemini Flash-Lite scoring (free at 30 RPM),
# text-embedding-004 for clustering, optional Gemini 2.5 Pro for angle generation.
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# YouTube Data API v3 key. Used for: search + playlistItems + videos endpoints.
# Get one at: https://console.cloud.google.com (enable "YouTube Data API v3")
YOUTUBE_API_KEY=

# Tavily search API key. Used for: Reddit ingestion (no Reddit OAuth required).
# 1000 free searches/month. Sign up at: https://tavily.com
TAVILY_API_KEY=

# Apify API token. Used for: X / Twitter scraping via the apidojo/twitter-scraper-lite actor.
# Polled every 12 hours to stay under £1/month. Get one at: https://console.apify.com
APIFY_TOKEN=

# ---- Snapshot transport (VPS -> Vercel Blob) ----

# Vercel Blob read-write token. The VPS writes `snapshot.json` here hourly;
# the Next.js dashboard reads it edge-cached. Create at vercel.com -> Storage -> Blob.
BLOB_READ_WRITE_TOKEN=

# ---- Optional: Notion (if you want video ideas pushed to a Notion DB) ----

# Notion integration token. Used for: writing top opportunities to a video-ideas DB.
# Get one at: https://www.notion.so/profile/integrations
NOTION_TOKEN=

# Notion database ID for the "Video Ideas Pipeline" database (or your own).
NOTION_VIDEO_IDEAS_DB_ID=

# ---- Optional: Telegram alerts ----

# Bot token + your user chat ID. Used for: viral-now alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
